# =============================================================================
# SAHAYA — Environment Configuration
# Copy this file to .env.local and provide your project credentials.
# When left blank, SAHAYA runs in Local Device Storage Mode (IndexedDB).
# =============================================================================

# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# Supabase Public Anon Key (safe for browser with Row-Level Security enabled)
VITE_SUPABASE_ANON_KEY=

# Optional: Secure Backend AI Proxy Endpoint (never put raw LLM API keys in frontend)
VITE_AI_PROXY_URL=
